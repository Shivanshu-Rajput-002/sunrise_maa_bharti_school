NODE_ENV=development
PORT=5000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_erp
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
# true in production (HTTPS)
COOKIE_SECURE=false

ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Headless Chrome/Chromium used to print old-format PDFs (auto-detected if empty)
CHROME_PATH=
